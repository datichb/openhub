{
  "entry_agent": "release-manager",
  "agents": [
    {
      "id": "release-manager",
      "mode": "primary",
      "model": "/claude-sonnet-4-6",
      "permissions": [
        "shell * deny",
        "shell ls* allow",
        "shell git add* allow",
        "shell git log* allow",
        "shell git tag* allow",
        "shell git diff* allow",
        "shell git show* allow",
        "shell git commit* allow",
        "shell git status* allow",
        "shell git tag -d* deny",
        "shell git tag -f* deny",
        "shell git tag* -f deny",
        "shell git tag* -d * deny",
        "shell git tag* -f * deny",
        "shell gh pr create* allow",
        "shell git cat-file* allow",
        "shell git describe* allow",
        "shell git rev-parse* allow",
        "shell date +%Y-%m-%d allow",
        "shell glab mr create* allow",
        "shell git tag* --force* deny",
        "shell git for-each-ref* allow",
        "shell git tag* --delete* deny",
        "shell git branch --show-current allow",
        "edit * ask",
        "edit CHANGELOG.md allow",
        "edit */CHANGELOG.md allow",
        "glob * allow",
        "grep * allow",
        "question * allow",
        "read * allow",
        "skill * allow",
        "subagent * deny",
        "todowrite * allow",
        "webfetch * deny",
        "websearch * deny",
        "shell *git* checkout * deny",
        "shell *git* restore * deny",
        "shell *git* reset --hard* deny",
        "shell *git* reset * --hard* deny",
        "shell *git* reset --merge* deny",
        "shell *git* reset * --merge* deny",
        "shell *git* reset --keep* deny",
        "shell *git* reset * --keep* deny",
        "shell *git* clean* deny",
        "shell *git* stash* deny",
        "shell *git* switch --discard-changes* deny",
        "shell *git* switch * --discard-changes* deny",
        "shell *git* switch -f* deny",
        "shell *git* switch * -f* deny",
        "shell *git* switch --force* deny",
        "shell *git* switch * --force* deny",
        "shell *git* worktree remove* deny",
        "shell *git* branch -D* deny",
        "shell *git* branch * -D* deny",
        "shell *git* rm * deny",
        "shell */bd deny",
        "shell */bd * deny",
        "shell *git*--no-verify* deny",
        "shell *git*commit* -n* deny",
        "shell *git*commit* -an* deny",
        "shell *.?ooks?ath* deny",
        "shell *GIT_CONFIG* deny",
        "shell *git*config*include* deny",
        "shell *.git/config* deny",
        "shell *.git/hooks* deny",
        "shell *.beads/hooks/* deny",
        "edit .git/* deny",
        "edit */.git/* deny",
        "edit .beads/hooks/* deny",
        "edit */.beads/hooks/* deny",
        "edit .husky/* ask",
        "edit */.husky/* ask",
        "edit .githooks/* ask",
        "edit */.githooks/* ask",
        "edit lefthook*.yml ask",
        "edit */lefthook*.yml ask",
        "edit .lefthook*.yml ask",
        "edit */.lefthook*.yml ask",
        "edit .pre-commit-config.yaml ask",
        "edit */.pre-commit-config.yaml ask",
        "shell *BD_GIT_HOOK* deny",
        "shell *.beads/redirect* deny",
        "shell *.beads/metadata.json* deny",
        "shell *.beads/config.yaml* deny",
        "shell *\u003e*.beads/* deny",
        "shell *.beads/embeddeddolt* deny",
        "shell *.beads/dolt/* deny",
        "edit .beads/* deny",
        "edit */.beads/* deny"
      ],
      "skills": [
        "pr-description",
        "release-management"
      ]
    }
  ],
  "skills": [
    "pr-description",
    "release-management"
  ],
  "subagent_graph": {},
  "max_depth": 1,
  "code_mode": false
}
