%% OpenHub -- TUI navigation modes (v5)
%% Hub, project and team modes and their home sections.

stateDiagram-v2
    [*] --> Hub : Default

    Hub --> Project : Select project / Ctrl+T (single project)
    Hub --> Team : Select team / Ctrl+T (single team)

    Project --> Hub : "Mode Hub" / Ctrl+T
    Project --> Team : Ctrl+T (team configured)

    Team --> Hub : "Mode Hub" / Ctrl+T
    Team --> Project : Select project

    state Hub {
        [*] --> HubHome
        HubHome : Start (pinned, recent workflows)
        HubHome : Running sessions (● N ⏸ M)
        HubHome : Teams list
        HubHome : System (Settings, Metrics, Doctor, Secrets)
        HubHome : Projects (Add project, projects list)
    }

    state Project {
        [*] --> ProjectHome
        ProjectHome : Start (pinned, recent, categories)
        ProjectHome : Project sessions
        ProjectHome : Project (Board, Metrics, Status)
        ProjectHome : Configuration (Project config + Execution, Worktrees, Project workflows)
        ProjectHome : Team (Status, Board, Activity)
    }

    state Team {
        [*] --> TeamHome
        TeamHome : Start (pinned, recent, categories)
        TeamHome : Team sessions
        TeamHome : Board (Team Board, Status, Activity, Takeovers, Board Columns)
        TeamHome : Configuration (Patterns, Policies, Team Config, Workflows, Sync Tracker)
        TeamHome : Navigation (Projects, Mode Hub)
    }
