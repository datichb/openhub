%% OpenHub -- Agent Hierarchy (v5)
%% 18 agents across 9 families, showing mode (primary/subagent)
%% and the delegations their permissions allow. In a session, the workflow
%% decides which agents are members and which delegations are reachable
%% (SubagentGraph, closed world): see ADR-039 and ADR-041.

flowchart TD
    subgraph Planning ["Planning Family (6 agents)"]
        direction TB
        COND["fa:fa-random <strong>conductor</strong><br/>Primary · Generic workflow entry<br/>read-only"]
        ORCH["fa:fa-sitemap <strong>orchestrator</strong><br/>Primary · Coordinator<br/>read-only"]
        ORCHDEV["fa:fa-code-branch <strong>orchestrator-dev</strong><br/>Primary · Coordinator<br/>read-only"]
        PLAN["fa:fa-tasks <strong>planner</strong><br/>Primary · Consultant<br/>read-only"]
        PATH["fa:fa-compass <strong>pathfinder</strong><br/>Primary · Recon<br/>read-only"]
        ONB["fa:fa-book <strong>onboarder</strong><br/>Primary · Discovery<br/>read-write"]
    end

    subgraph Developer ["Developer Family (1 agent)"]
        direction TB
        DEV["fa:fa-code <strong>developer</strong><br/>Subagent · Domains incl. refactor, migration, tests<br/>read-write"]
    end

    subgraph Infra ["Infra Family (1 agent)"]
        OPS["fa:fa-server <strong>operator</strong><br/>Primary · Plan and apply<br/>no file edits"]
    end

    subgraph Auditor ["Auditor Family (2 agents)"]
        direction TB
        AUD["fa:fa-shield <strong>auditor</strong><br/>Primary · Coordinator<br/>read-only"]
        AUDS["fa:fa-search <strong>auditor-subagent</strong><br/>Subagent · Domain expert<br/>read-only"]
    end

    subgraph Quality ["Quality Family (3 agents)"]
        direction TB
        REV["fa:fa-check-circle <strong>reviewer</strong><br/>Primary · Code review<br/>read-only"]
        DBG["fa:fa-bug <strong>debugger</strong><br/>Primary · Diagnostics<br/>read-only"]
        BENCH["fa:fa-tachometer <strong>benchmarker</strong><br/>Primary · Performance<br/>read-write"]
    end

    subgraph Design ["Design Family (1 agent)"]
        DES["fa:fa-paint-brush <strong>designer</strong><br/>Primary · UX+UI<br/>read-only · MCP: Figma"]
    end

    subgraph Documentation ["Documentation Family (1 agent)"]
        DOC["fa:fa-file-text <strong>documentarian</strong><br/>Primary · Tech writer<br/>read-write"]
    end

    subgraph Delivery ["Delivery Family (2 agents)"]
        direction TB
        REL["fa:fa-tag <strong>release-manager</strong><br/>Primary · Release entry (release)<br/>delegates nothing"]
        MRG["fa:fa-code-fork <strong>merger</strong><br/>Primary · Merge conflicts (merge-conflicts)<br/>read-write"]
    end

    OHF(["oh · fan-out driver"])

    subgraph Utility ["Utility Family (1 agent)"]
        BRF["fa:fa-info-circle <strong>brief-enricher</strong><br/>Subagent · Analysis<br/>read-only"]
    end

    %% Delegation edges
    COND -.->|"workflow members only"| PATH
    COND -.->|"workflow members only"| PLAN
    COND -.->|"workflow members only"| DEV
    ORCH -->|delegates| PATH
    ORCH -->|delegates| PLAN
    ORCH -->|delegates| ONB
    ORCH -->|delegates| DES
    ORCH -->|delegates| ORCHDEV
    ORCH -->|delegates| DBG

    ORCHDEV -->|routes to| DEV
    ORCHDEV -->|routes to| REV
    ORCHDEV -->|routes to| DOC

    AUD -->|delegates| AUDS

    PLAN -->|delegates| DES
    PATH -->|delegates| DES

    OHF -.->|"conflict it cannot resolve (merge-conflicts session)"| MRG

    style Planning fill:#3498db15,stroke:#3498db
    style Developer fill:#2ecc7115,stroke:#2ecc71
    style Auditor fill:#e74c3c15,stroke:#e74c3c
    style Infra fill:#34495e15,stroke:#34495e
    style Quality fill:#f39c1215,stroke:#f39c12
    style Design fill:#9b59b615,stroke:#9b59b6
    style Documentation fill:#1abc9c15,stroke:#1abc9c
    style Delivery fill:#e67e2215,stroke:#e67e22
    style Utility fill:#95a5a615,stroke:#95a5a6
