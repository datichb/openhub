%% OpenHub -- Model resolution cascade (v5)
%% First level that defines a model wins (O9). The workflow levels come from the
%% `models:` block of the resolved oh/v1 workflow; the cascade is applied when the
%% session bundle is built (internal/bundle, Request.ResolveModel).
%% The engine also knows team recommendation levels (between hub and frontmatter),
%% but the v5 launch does not fill them yet.

flowchart TD
    Start([Model of an agent in the session bundle]) --> L1

    L1[/"1. Workflow — agent<br/><code>models.agents.&lt;id&gt;</code>"/]
    L1 --> Q1{Defined?}
    Q1 -- Yes --> Stop([Use this model])
    Q1 -- No --> L2

    L2[/"2. Workflow — default<br/><code>models.default</code>"/]
    L2 --> Q2{Defined?}
    Q2 -- Yes --> Stop
    Q2 -- No --> L3

    L3[/"3. Project — agent override"/]
    L3 --> Q3{Defined?}
    Q3 -- Yes --> Stop
    Q3 -- No --> L4

    L4[/"4. Project — family override"/]
    L4 --> Q4{Defined?}
    Q4 -- Yes --> Stop
    Q4 -- No --> L5

    L5[/"5. Project — default model"/]
    L5 --> Q5{Defined?}
    Q5 -- Yes --> Stop
    Q5 -- No --> L6

    L6[/"6. Hub — agent override<br/><code>[models.agents]</code>"/]
    L6 --> Q6{Defined?}
    Q6 -- Yes --> Stop
    Q6 -- No --> L7

    L7[/"7. Hub — family override<br/><code>[models.families]</code>"/]
    L7 --> Q7{Defined?}
    Q7 -- Yes --> Stop
    Q7 -- No --> L8

    L8[/"8. Hub — default<br/><code>[models] default</code>"/]
    L8 --> Q8{Defined?}
    Q8 -- Yes --> Stop
    Q8 -- No --> L9

    L9[/"9. Agent frontmatter <code>model:</code>"/]
    L9 --> Q9{Defined?}
    Q9 -- Yes --> Stop
    Q9 -- No --> None([No model: opencode default])

    Stop --> N["Normalized for the provider<br/>(e.g. amazon-bedrock/eu.… for Bedrock eu-*)"]
    N --> AL{"limits.models allow-list<br/>(I6) set?"}
    AL -- "model not allowed" --> Ref([Refused at the proxy])
    AL -- "allowed / no list" --> OK([Used by the session])

    style Start fill:#4a90d9,color:#fff
    style Stop fill:#2ecc71,color:#fff
    style OK fill:#2ecc71,color:#fff
    style None fill:#95a5a6,color:#fff
    style Ref fill:#e74c3c,color:#fff
    style L1 fill:#f1c40f30
    style L2 fill:#f1c40f30
