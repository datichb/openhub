%% OpenHub -- Workflow scenarios map (v5)
%% "What do you need?" -> one of the 12 workflows shipped by the hub
%% (workflows/*.yaml), grouped by category, with their entry agent, risk and
%% allowed runtimes (⌂ local, ▣ container, ☁ remote).
%% Solid arrows: "Chain with…" suggestions at the end of a session (a typed output
%% feeds an input of the next workflow: branch → branch, beads-ids → beads-id(s)).
%% Dotted arrows: preconditions (missing project context → run onboarding first, then resume).

flowchart LR
    Start(["What do you need?"])
    Start -->|"frame a need, create tickets"| CAD
    Start -->|"new feature, end to end"| FEAT
    Start -->|"implement ready tickets"| TICK
    Start -->|"small change"| QUICK
    Start -->|"repetitive change on many files"| SWEEP
    Start -->|"apply MR comments"| RF
    Start -->|"review a branch"| REV
    Start -->|"audit the code"| AUD
    Start -->|"fix a bug"| DBG
    Start -->|"document the project"| ONB
    Start -->|"one agent, no workflow"| LIB

    subgraph FRAME ["Frame"]
        CAD["<b>cadrage</b><br/>conductor · plan · ⌂"]
    end

    subgraph DEVELOP ["Develop"]
        FEAT["<b>feature</b><br/>orchestrator · write · ⌂"]
        TICK["<b>ticket</b><br/>orchestrator-dev · write · ⌂ ▣ ☁<br/>one session per ticket"]
        QUICK["<b>quick</b><br/>developer · write · ⌂"]
        SWEEP["<b>sweep</b><br/>conductor · write · ⌂"]
        RF["<b>review-feedback</b><br/>orchestrator-dev · write · ⌂"]
    end

    subgraph QUALITY ["Quality"]
        REV["<b>review</b><br/>reviewer · read · ⌂ ☁"]
        AUD["<b>audit</b><br/>auditor · read · ⌂ ☁"]
        DBG["<b>debug</b><br/>debugger · write · ⌂"]
    end

    subgraph KNOWLEDGE ["Knowledge"]
        ONB["<b>onboarding</b><br/>onboarder · write · ⌂ ☁"]
        BRF["<b>brief-enrich</b><br/>brief-enricher · read · ⌂<br/>headless"]
    end

    subgraph OTHER ["Other"]
        LIB["<b>libre</b><br/>entry agent of your choice · write · ⌂ ▣"]
    end

    CAD -->|"tickets"| TICK
    CAD -->|"tickets"| FEAT
    CAD -->|"tickets"| BRF
    FEAT -->|"branch"| REV
    FEAT -->|"tickets"| TICK
    TICK -->|"branch"| REV
    TICK -->|"branch"| RF
    SWEEP -->|"branch"| REV
    RF -->|"branch"| REV
    DBG -->|"tickets"| TICK

    FEAT -.->|"no project context"| ONB
    CAD -.->|"no project context"| ONB

    style FRAME fill:#9b59b610,stroke:#9b59b6
    style DEVELOP fill:#2ecc7110,stroke:#2ecc71
    style QUALITY fill:#f39c1210,stroke:#f39c12
    style KNOWLEDGE fill:#3498db10,stroke:#3498db
    style OTHER fill:#95a5a610,stroke:#95a5a6
